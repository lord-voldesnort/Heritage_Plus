{
  "name": "heritage-pulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "echo 'Requires: server/ running with migrate+seed+seed:test-user done first (see src/test/api-integration.test.ts header).' && vitest run api-integration.test.ts packetData.integration.test.ts",
    "gate:check": "node scripts/check-gate.mjs",
    "team:status": "node scripts/show-next-task.mjs",
    "team:validate": "node scripts/validate-task-status.mjs",
    "contract:validate": "node scripts/validate-contract.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@turf/turf": "^7.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^2.1.6"
  }
}
