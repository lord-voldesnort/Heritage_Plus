# HERITAGE PULSE ENVIRONMENT CONFIGURATION

# Port Configuration
PORT=3000
VITE_API_URL=http://localhost:3000/api

# MapLibre Tile Configuration
# Note: For prototype testing, MapLibre GL uses free open vector tiles (e.g. OpenStreetMap / CARTO / Stamen free basemaps).
# If switching to a hosted vector tile provider (e.g., MapTiler / Stadia Maps / Protomaps), add your key below.
VITE_MAP_TILE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
VITE_MAP_API_KEY=optional_free_tier_key_here

# Storage Path (Local file store in prototype; swap with MinIO / S3 in production)
STORAGE_LOCAL_DIR=./uploads
