# Heritage Pulse API server configuration

PORT=3000
NODE_ENV=development

# PostgreSQL + PostGIS connection string.
DATABASE_URL=postgresql://heritage:heritage_dev_local_only@localhost:5432/heritage_plus

# Secret used to sign session cookies. Generate a real one with:
#   openssl rand -base64 48
# Required in production; a random dev-only value is used automatically if
# unset outside production (sessions won't survive a restart in that case).
SESSION_SECRET=

# CORS: comma-separated list of allowed origins for the frontend dev server.
CORS_ORIGIN=http://localhost:5173

# Public STAC catalog used for authenticated Sentinel-2 scene discovery.
# Override with an approved institutional catalog when deploying elsewhere.
STAC_CATALOG_URL=https://earth-search.aws.element84.com/v1

# Local evidence file storage is suitable only for development. Supabase and
# S3 modes use explicit remote object storage and refuse silent local fallback.
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Storage mode: local, supabase, or s3.
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# EO processing worker boundary. Discovery remains available independently;
# long-running raster processing is disabled unless a deployed worker enables it.
WORKER_ENABLED=false
WORKER_CONCURRENCY=1
EO_PROCESSING_ENABLED=false

# Set to "true" to enable the /api/dev/* demo-seeding endpoints used by the
# in-app Evaluator Simulation Quickbar. Must be false/unset in production —
# these endpoints insert illustrative, non-real observation records.
ENABLE_DEMO_SEED_ROUTES=true
